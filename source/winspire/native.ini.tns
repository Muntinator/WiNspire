[pc]
bios = bios.bin.tns
vga_bios = vgabios.bin.tns
mem_size = 16M
vga_mem_size = 256K

; Boot media. The included benchmark floppy boots on its own, so a fresh
; install shows something on screen with no extra files. For Windows 95:
; rename your raw disk image to disk.img.tns, uncomment the hda line and
; comment out the fda line (the floppy would otherwise boot first).
;hda = disk.img.tns
fda = bench386.img.tns

fill_cmos = 1

[display]
width = 320
height = 240

[cpu]
gen = 4
fpu = 0
clock_hz = 4770000

; Uplink credentials for the optional ESP32 bridge (NETWORK_ARCHITECTURE.md 6.3).
; The bridge has no console, so they are read here and sent over the dock link.
; Nothing else reads them, nothing writes them anywhere else, and the password is
; never printed.
;
;   ssid      1-31 characters
;   password  8-63 characters, or empty/absent for an open network
;
; Values are taken literally: do not quote them, and keep a space before any
; trailing ';' or '#' comment. Comment both lines out to run with no Wi-Fi.
;
;[network]
;ssid = MyHomeNetwork
;password = correcthorsebatterystaple

; Panel orientation, for the calculator target only (ignored elsewhere).
;
; Which correction a unit needs depends on how its LCD is mounted, and that is
; not readable through the Ndless API. It is a setting here rather than a
; constant compiled into the binary because getting it wrong by reasoning has
; cost several releases; it should be read off a photograph instead.
;
;   0  leave the guest surface alone
;   1  flip top-to-bottom
;   2  flip left-to-right
;   3  rotate 180 degrees   (the default)
;
; To find the right value on hardware, set orientation_marker = 1: white
; brackets are drawn in the four corners with four different pairs of leg
; lengths. One photograph then says which corner is which. Turn it back off
; afterwards - it is an overlay, not part of the guest screen.
;
[nspire]
orientation = 3
;orientation_marker = 0
